---
interface Props { name?: 'arrow' | 'external' | 'download'; }
const { name = 'arrow' } = Astro.props;
---
<svg class:list={['icon', `icon-${name}`]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'download' ? <><path d="M12 3v12m-4-4 4 4 4-4" /><path d="M5 17v4h14v-4" /></> : name === 'external' ? <><path d="M7 17 17 7M7 7h10v10" /></> : <><path d="M4 12h16m-6-6 6 6-6 6" /></>}
</svg>
