---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
---
<section class="hero" id="home" data-section="hero" data-nav-section="home" aria-label="Introduction">
  <Container>
    <div class="hero-layout">
      <div class="hero-visual" data-hero-visual>
        <img class="hero-plane hero-plane-far hero-plane-a" src="/images/planes/a.jpg" alt="" width="1024" height="602" />
        <img class="hero-plane hero-plane-far hero-plane-b" src="/images/planes/b.jpg" alt="" width="823" height="1024" />
        <img class="hero-plane hero-plane-far hero-plane-c" src="/images/planes/c.jpg" alt="" width="1024" height="682" />
        <img class="hero-plane hero-plane-d" src="/images/planes/d.png" alt="" width="1024" height="595" />
        <img class="hero-plane hero-plane-e" src="/images/planes/e.jpg" alt="" width="1024" height="576" />
        <img class="hero-plane hero-plane-f" src="/images/planes/f.png" alt="" width="806" height="407" />
        <img class="hero-plane hero-plane-feature hero-plane-g" src="/images/planes/g.gif" alt="" width="594" height="1000" />
        <img class="hero-portrait" src="/images/george-ashe.png" alt="George Ashe" width="611" height="819" />
      </div>
      <div class="hero-content">
      <p class="eyebrow">Experimental systems / Engineering portfolio</p>
      <h1>{site.name}</h1>
      <p class="hero-profession">{site.profession}</p>
      <p class="hero-domains">{site.domains}</p>
      <p class="lede">{site.positioning}</p>
      <div class="actions">
        <Button href="#projects" icon="arrow">Explore the work</Button>
        <Button href="/about/" variant="secondary" icon="external">About George</Button>
      </div>
      <p class="hero-footnote">Measurement → hardware → insight</p>
      <slot name="visual" />
      </div>
    </div>
  </Container>
</section>
