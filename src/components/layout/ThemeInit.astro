<!-- Apply the preference before styles paint; storage may be unavailable in private browsing. -->
<script is:inline data-portfolio-script="theme-init">
  (() => {
    let saved;
    try { saved = localStorage.getItem('portfolio-theme'); } catch {}
    const theme = saved === 'light' || saved === 'dark' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    document.documentElement.dataset.theme = theme;
  })();
</script>
