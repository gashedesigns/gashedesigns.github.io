---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../data/site';
import { effects } from '../data/visual';
import ThemeInit from '../components/layout/ThemeInit.astro';
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; type?: 'website' | 'article'; tags?: string[]; }
const { title, description = site.introduction, image, imageAlt, type = 'website', tags = [] } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Engineering Physicist`;
const canonical = new URL(Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-reveals={effects.reveals ? 'on' : 'off'} data-card-motion={effects.cardMotion ? 'on' : 'off'} data-icon-motion={effects.iconMotion ? 'on' : 'off'} data-nav-motion={effects.navMotion ? 'on' : 'off'}><head>
  <meta charset="UTF-8" />
  <ThemeInit />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={site.name} />
  {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={`${site.name} — Engineering portfolio`} />
  {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
  {image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  {type === 'article' && tags.map(tag => <meta property="article:tag" content={tag} />)}
</head>
<body><a class="skip-link" href="#main">Skip to content</a><Header /><main id="main"><slot /></main><Footer /></body></html>

<script>
  import '../scripts/portfolio';
</script>
