---
import { render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { getProjects, projectSlug } from '../../lib/projects';
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map(project => ({ params: { slug: projectSlug(project) }, props: { project, projects } }));
}
const { project, projects } = Astro.props;
const { Content, headings } = await render(project);
---
<ProjectLayout project={project} projects={projects} headings={headings}><Content /></ProjectLayout>
